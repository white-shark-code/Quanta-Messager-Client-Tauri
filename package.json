{
  "name": "quant-messenger-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "build:tauri": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"try{require('child_process').execSync('git rev-parse --git-dir',{stdio:'ignore'})}catch(e){process.exit(0)}require('child_process').execSync('lefthook install',{stdio:'inherit'})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:remote": "bash scripts/test-remote.sh",
    "test:ws-live": "node scripts/test-ws-live.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-stronghold": "^2",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-import": "^2",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "eslint-plugin-security": "^3",
    "jsdom": "^25.0.1",
    "lefthook": "^1",
    "msw": "^2",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^5",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@mantine/core": "^7",
    "@mantine/form": "^7",
    "@mantine/hooks": "^7",
    "@mantine/notifications": "^7",
    "@stablelib/chacha20poly1305": "^1.0",
    "@tabler/icons-react": "^3",
    "@tanstack/react-query": "^5.102.8",
    "dayjs": "^1",
    "hash-wasm": "^4.12",
    "i18next": "^23",
    "openpgp": "^6.3.1",
    "react": "^18",
    "react-dom": "^18",
    "react-i18next": "^14",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^6",
    "zustand": "^4"
  }
}
